# Hosted frontier model settings.
# Get a Gemini API key from Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Local open-source model settings.
OSS_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Optional: call a deployed OSS model endpoint instead of loading Qwen locally.
# OSS_API_URL=https://atharvjairath-qwen2-5-0-5b-instruct.hf.space
# OSS_API_URL=https://atharv-jairath--qwen-oss-assistant-api-fastapi-app.modal.run
